{
  "name": "@tpm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:setup:local": "wrangler d1 migrations apply transmission-project-manager-local --local",
    "dev": "npm run db:setup:local && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tpm/shared": "*",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}
