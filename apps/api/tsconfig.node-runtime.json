{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/app.ts",
    "src/auth.ts",
    "src/credential.ts",
    "src/runtime-env.ts",
    "src/schema.ts",
    "src/session.ts",
    "src/demand-import.ts",
    "src/reserve-planning.ts",
    "src/finance.ts",
    "src/project-lifecycle.ts",
    "src/analysis-operations.ts",
    "src/project-execution.ts",
    "src/transmission-grid.ts",
    "src/master-data-config.ts",
    "src/physical-towers.ts",
    "src/structured-demand.ts",
    "src/application/**/*.ts",
    "src/ports/**/*.ts",
    "src/repositories/**/*.ts",
    "src/adapters/node/**/*.ts",
    "src/runtime/persistence.ts",
    "src/runtime/node/**/*.ts"
