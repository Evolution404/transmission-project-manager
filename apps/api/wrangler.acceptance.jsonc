{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "transmission-project-manager",
  "account_id": "642d30520d6c494dd418b1f4b3853aa6",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "APP_ENV": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transmission-project-manager-acceptance",
      "database_id": "c1dbd68e-8626-4cb1-a7a8-f9fe07df705b",
      "migrations_dir": "migrations"
    }
  ]
}
