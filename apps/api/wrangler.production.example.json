{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "replace-production-worker",
  "account_id": "00000000000000000000000000000000",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "OBJECT_STORAGE_PROVIDER": "notion",
    "NOTION_API_VERSION": "2026-03-11",
    "NOTION_STORAGE_DATA_SOURCE_ID": "00000000-0000-0000-0000-000000000000"
  },
  "secrets": { "required": ["AUTH_CREDENTIAL_PEPPER", "NOTION_API_TOKEN"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "replace.example.invalid", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "replace-production-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
