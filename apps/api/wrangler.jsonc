{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "transmission-project-manager-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "APP_ENV": "development"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transmission-project-manager-local",
      // Placeholder for local emulation only. Do not use for remote deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "transmission-project-manager-local" }
  ]
}
