{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "transmission-project-manager",
  "account_id": "642d30520d6c494dd418b1f4b3853aa6",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "OBJECT_STORAGE_PROVIDER": "notion",
    "NOTION_API_VERSION": "2026-03-11",
    "NOTION_STORAGE_DATA_SOURCE_ID": "33a70b5a-c477-409f-ba61-78679279ce7e"
  },
  "secrets": {
    "required": ["AUTH_CREDENTIAL_PEPPER", "NOTION_API_TOKEN"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    { "pattern": "project.980923.xyz", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transmission-project-manager-production",
      "database_id": "32ab1d29-e720-41a1-a83f-11b579734a0e",
      "migrations_dir": "migrations"
    }
  ]
}
